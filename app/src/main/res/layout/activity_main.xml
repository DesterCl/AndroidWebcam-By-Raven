<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 AndroidWebcam"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTSP · H.264 Hardware · Sin límites"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="12dp" />

        <!-- Vista previa compatible con RtspCamera2 -->
        <com.pedro.library.view.OpenGlView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="14dp" />

        <!-- Selector de cámara -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cámara"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerCamera"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="12dp" />

        <!-- Selector de calidad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calidad"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerQuality"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="12dp" />

        <!-- Zoom -->
        <TextView
            android:id="@+id/tvZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zoom: 1.0x"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/seekZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Fila de controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🔄 Girar"
                android:textSize="13sp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnFlash"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🔦 Flash OFF"
                android:textSize="13sp"
                android:backgroundTint="#E65100"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Audio -->
        <Button
            android:id="@+id/btnAudio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🎙️ Audio OFF"
            android:textSize="14sp"
            android:backgroundTint="#4A148C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Iniciar / detener -->
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Iniciar Stream"
            android:textSize="16sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Estado -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 Detenido"
            android:textSize="15sp"
            android:textColor="#FF5555"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS: --"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvOrientation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Vertical"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#4FC3F7"
            android:textIsSelectable="true"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📌 Abre la URL en VLC u OBS (fuente RTSP)"
            android:textSize="11sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
